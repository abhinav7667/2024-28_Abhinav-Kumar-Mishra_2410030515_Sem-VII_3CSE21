# NetSage AI Environment Configuration
# Copy this file to .env and fill in your values

# ─── AI Provider ───────────────────────────────────────────────────────────────
# Set DEMO_MODE=true to use mock AI responses without an API key
DEMO_MODE=true

# Supported providers: openai, google, anthropic
AI_PROVIDER=openai

# Your AI API key (leave empty in demo mode)
AI_API_KEY=your_api_key_here

# Model name (e.g. gpt-4o, gemini-1.5-pro, claude-3-5-sonnet)
AI_MODEL=gpt-4o

# ─── Flask ─────────────────────────────────────────────────────────────────────
FLASK_SECRET_KEY=netsage-ai-secret-change-this-in-production
FLASK_DEBUG=true

# ─── Database ──────────────────────────────────────────────────────────────────
# Default: SQLite in instance/ folder
DATABASE_URL=sqlite:///instance/netsage.db
